{
  "name": "harness-navigator",
  "displayName": "AI Development Harness Navigator",
  "description": "VSCode extension for AI Development Harness projects: command palette, artifact explorer, STEP file editor, status bar and agent integration.",
  "version": "0.0.1",
  "publisher": "ai-development-harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-development-harness/ai-development-harness-vscode-extension"
  },
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "harness.changeLanguage",
        "title": "%harness.command.changeLanguage.title%",
        "category": "Harness"
      },
      {
        "command": "harness.init",
        "title": "%harness.command.init.title%",
        "category": "Harness"
      },
      {
        "command": "harness.addStep",
        "title": "%harness.command.addStep.title%",
        "category": "Harness"
      },
      {
        "command": "harness.plan",
        "title": "%harness.command.plan.title%",
        "category": "Harness"
      },
      {
        "command": "harness.implement",
        "title": "%harness.command.implement.title%",
        "category": "Harness"
      },
      {
        "command": "harness.review",
        "title": "%harness.command.review.title%",
        "category": "Harness"
      },
      {
        "command": "harness.fix",
        "title": "%harness.command.fix.title%",
        "category": "Harness"
      },
      {
        "command": "harness.run",
        "title": "%harness.command.run.title%",
        "category": "Harness"
      },
      {
        "command": "harness.nextStep",
        "title": "%harness.command.nextStep.title%",
        "category": "Harness"
      },
      {
        "command": "harness.status",
        "title": "%harness.command.status.title%",
        "category": "Harness"
      },
      {
        "command": "harness.quickFix",
        "title": "%harness.command.quickFix.title%",
        "category": "Harness"
      },
      {
        "command": "harness.reconcile",
        "title": "%harness.command.reconcile.title%",
        "category": "Harness"
      },
      {
        "command": "harness.explorer.refresh",
        "title": "%harness.command.explorer.refresh.title%",
        "category": "Harness",
        "icon": "$(refresh)"
      },
      {
        "command": "harness.explorer.filterByStatus",
        "title": "%harness.command.explorer.filterByStatus.title%",
        "category": "Harness"
      },
      {
        "command": "harness.explorer.filterByType",
        "title": "%harness.command.explorer.filterByType.title%",
        "category": "Harness"
      },
      {
        "command": "harness.explorer.filterByPriority",
        "title": "%harness.command.explorer.filterByPriority.title%",
        "category": "Harness"
      },
      {
        "command": "harness.explorer.filterByRiskFlag",
        "title": "%harness.command.explorer.filterByRiskFlag.title%",
        "category": "Harness"
      },
      {
        "command": "harness.explorer.search",
        "title": "%harness.command.explorer.search.title%",
        "category": "Harness",
        "icon": "$(search)"
      },
      {
        "command": "harness.explorer.clearFilters",
        "title": "%harness.command.explorer.clearFilters.title%",
        "category": "Harness",
        "icon": "$(clear-all)"
      },
      {
        "command": "harness.explorer.openFile",
        "title": "%harness.command.explorer.openFile.title%",
        "category": "Harness"
      },
      {
        "command": "harness.explorer.viewInExplorer",
        "title": "%harness.command.explorer.viewInExplorer.title%",
        "category": "Harness"
      },
      {
        "command": "harness.explorer.markDone",
        "title": "%harness.command.explorer.markDone.title%",
        "category": "Harness"
      },
      {
        "command": "harness.explorer.flagBlocker",
        "title": "%harness.command.explorer.flagBlocker.title%",
        "category": "Harness"
      },
      {
        "command": "harness.explorer.createFollowUpStep",
        "title": "%harness.command.explorer.createFollowUpStep.title%",
        "category": "Harness"
      },
      {
        "command": "harness.explorer.delete",
        "title": "%harness.command.explorer.delete.title%",
        "category": "Harness"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "harness",
          "title": "Harness",
          "icon": "resources/harness.svg"
        }
      ]
    },
    "views": {
      "harness": [
        {
          "id": "harness.artifacts",
          "name": "%harness.view.artifacts.name%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "harness.artifacts",
        "contents": "%harness.explorer.viewsWelcome%\n[%harness.explorer.viewsWelcome.button%](command:harness.init)",
        "when": "harness.isHarnessProject == false"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "harness.explorer.refresh",
          "when": "view == harness.artifacts",
          "group": "navigation@1"
        },
        {
          "command": "harness.explorer.search",
          "when": "view == harness.artifacts",
          "group": "navigation@2"
        },
        {
          "command": "harness.explorer.clearFilters",
          "when": "view == harness.artifacts && harness.explorer.hasFilters",
          "group": "navigation@3"
        },
        {
          "command": "harness.explorer.filterByStatus",
          "when": "view == harness.artifacts",
          "group": "1_filters"
        },
        {
          "command": "harness.explorer.filterByType",
          "when": "view == harness.artifacts",
          "group": "1_filters"
        },
        {
          "command": "harness.explorer.filterByPriority",
          "when": "view == harness.artifacts",
          "group": "1_filters"
        },
        {
          "command": "harness.explorer.filterByRiskFlag",
          "when": "view == harness.artifacts",
          "group": "1_filters"
        }
      ],
      "view/item/context": [
        {
          "command": "harness.addStep",
          "when": "view == harness.artifacts && viewItem =~ /^harness\\.group$/",
          "group": "1_create"
        },
        {
          "command": "harness.explorer.createFollowUpStep",
          "when": "view == harness.artifacts && viewItem =~ /^harness\\.step\\b/",
          "group": "1_create"
        },
        {
          "command": "harness.explorer.openFile",
          "when": "view == harness.artifacts && viewItem =~ /^harness\\.(step|req|adr|file)\\b/",
          "group": "2_open"
        },
        {
          "command": "harness.explorer.viewInExplorer",
          "when": "view == harness.artifacts && viewItem =~ /^harness\\.(step|req|adr|file)\\b/",
          "group": "2_open"
        },
        {
          "command": "harness.explorer.markDone",
          "when": "view == harness.artifacts && viewItem =~ /harness\\.step\\.canMarkDone/",
          "group": "3_mutate"
        },
        {
          "command": "harness.explorer.flagBlocker",
          "when": "view == harness.artifacts && viewItem =~ /^harness\\.step\\b/",
          "group": "3_mutate"
        },
        {
          "command": "harness.explorer.delete",
          "when": "view == harness.artifacts && viewItem =~ /^harness\\.step\\b/",
          "group": "4_destructive"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc --noEmit",
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "lint": "eslint src",
    "test": "jest",
    "test:integration": "vscode-test",
    "vscode:prepublish": "npm run build",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.3",
    "@types/vscode": "^1.138.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "mocha": "^12.0.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
